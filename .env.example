# Database settings
DATABASE_URL=postgresql://nw_admin:nw_password_2026@localhost:5432/nw_digital_ops_hub

# Redis settings
REDIS_URL=redis://localhost:6379/0

# Security settings
# Generate JWT_SECRET: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encryption Key (Fernet symmetric key for token encryption at rest in DB)
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=


# Downstream Intern APIs
VISHAQA_API_URL=http://localhost:8001
ASMA_API_URL=http://localhost:8002
ESHA_API_URL=http://localhost:8003

# Portal & Frontend settings
PORT=8000
HOST=0.0.0.0
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=*

# Seeding configuration (set ALLOW_SEED=true for local dev auto-seeding and seed API access)
ALLOW_SEED=true
NEXT_PUBLIC_ALLOW_SEED=true

# Mock Mode (set to true for offline/local mock fallbacks, false in production)
MOCK_MODE=false

# External AI Services
# Groq API Key (Place your actual Groq API key GSK value below for Asma service LLM integration)
GROQ_API_KEY=
